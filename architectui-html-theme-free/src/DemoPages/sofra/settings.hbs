{{#> base }}
    {{> AppSidebar/sidebar sofra-settings=this }}
    <div class="app-main__outer">
        <div class="app-main__inner">
            {{> AppMain/page-title }}

            <div class="row">
                <div class="col-md-8">
                    <div class="main-card mb-3 card">
                        <div class="card-header">Restaurant Information</div>
                        <div class="card-body">
                            <form>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" for="restaurantName">Restaurant Name</label>
                                        <input type="text" class="form-control" id="restaurantName" value="Sofra">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" for="restaurantPhone">Phone</label>
                                        <input type="text" class="form-control" id="restaurantPhone" placeholder="+20 100 000 0000">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" for="restaurantEmail">Email</label>
                                        <input type="email" class="form-control" id="restaurantEmail" placeholder="info@sofra.com">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" for="restaurantAddress">Address</label>
                                        <input type="text" class="form-control" id="restaurantAddress" placeholder="Restaurant address">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" for="openingTime">Opening Time</label>
                                        <input type="time" class="form-control" id="openingTime" value="10:00">
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label" for="closingTime">Closing Time</label>
                                        <input type="time" class="form-control" id="closingTime" value="23:00">
                                    </div>
                                </div>

                                <hr class="my-4">

                                <h6 class="text-muted text-uppercase font-size-sm mb-3">Restaurant Logo</h6>
                                <div class="mb-4 d-flex align-items-center">
                                    <div class="me-3 d-flex align-items-center justify-content-center rounded bg-light" style="width:64px;height:64px;">
                                        <i class="fa-solid fa-utensils fa-lg" style="color:#3ac47d;"></i>
                                    </div>
                                    <input class="form-control" type="file" id="restaurantLogo" style="max-width:320px;">
                                </div>

                                <hr class="my-4">

                                <h6 class="text-muted text-uppercase font-size-sm mb-3">System Settings</h6>
                                <div class="row">
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label" for="currency">Currency</label>
                                        <select class="form-select" id="currency">
                                            <option selected>EGP</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label" for="language">Language</label>
                                        <select class="form-select" id="language">
                                            <option selected>English</option>
                                            <option>Arabic</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4 mb-3">
                                        <label class="form-label" for="timezone">Timezone</label>
                                        <select class="form-select" id="timezone">
                                            <option selected>Africa/Cairo (GMT+2)</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa-solid fa-floppy-disk me-1"></i> Save Changes
                                    </button>
                                    <button type="reset" class="btn btn-outline-secondary ms-2">Reset</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="main-card mb-3 card">
                        <div class="card-header">Admin Profile</div>
                        <div class="card-body text-center">
                            <img src="assets/images/avatars/1.jpg" width="72" class="rounded-circle mb-2" alt="Sofra Admin">
                            <h6 class="mb-0">Sofra Admin</h6>
                            <div class="text-muted">Restaurant Administrator</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
{{/base}}
