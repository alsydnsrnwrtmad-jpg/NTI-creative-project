{{#> base }}
    {{> AppSidebar/sidebar dashboards-eg-1=this }}
    <div class="app-main__outer">
        <div class="app-main__inner">
            {{> AppMain/page-title }}

            <!-- Stat Cards -->
            <div class="row">
                <div class="col-md-6 col-xl-4">
                    <div class="card mb-3 widget-content bg-midnight-bloom">
                        <div class="widget-content-wrapper text-white">
                            <div class="widget-content-left">
                                <div class="widget-heading">Total Orders</div>
                                <div class="widget-subheading">All time orders</div>
                            </div>
                            <div class="widget-content-right">
                                <div class="widget-numbers text-white"><span>125</span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4">
                    <div class="card mb-3 widget-content bg-arielle-smile">
                        <div class="widget-content-wrapper text-white">
                            <div class="widget-content-left">
                                <div class="widget-heading">Pending Orders</div>
                                <div class="widget-subheading">Awaiting confirmation</div>
                            </div>
                            <div class="widget-content-right">
                                <div class="widget-numbers text-white"><span>18</span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-4">
                    <div class="card mb-3 widget-content bg-grow-early">
                        <div class="widget-content-wrapper text-white">
                            <div class="widget-content-left">
                                <div class="widget-heading">Total Sales</div>
                                <div class="widget-subheading">Revenue this month</div>
                            </div>
                            <div class="widget-content-right">
                                <div class="widget-numbers text-white"><span>24,500 EGP</span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-6">
                    <div class="card mb-3 widget-content bg-premium-dark">
                        <div class="widget-content-wrapper text-white">
                            <div class="widget-content-left">
                                <div class="widget-heading">Total Customers</div>
                                <div class="widget-subheading">Registered customers</div>
                            </div>
                            <div class="widget-content-right">
                                <div class="widget-numbers text-white"><span>340</span></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-xl-6">
                    <div class="card mb-3 widget-content bg-tempting-azure">
                        <div class="widget-content-wrapper text-white">
                            <div class="widget-content-left">
                                <div class="widget-heading">Total Meals</div>
                                <div class="widget-subheading">Active menu items</div>
                            </div>
                            <div class="widget-content-right">
                                <div class="widget-numbers text-white"><span>42</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Sales Overview + Recent Orders -->
            <div class="row">
                <div class="col-md-12">
                    <div class="main-card mb-3 card">
                        <div class="card-header">
                            <i class="header-icon pe-7s-graph3 icon-gradient bg-mean-fruit"> </i>
                            Sales Overview
                            <div class="btn-actions-pane-right text-muted">Last 7 days &middot; EGP</div>
                        </div>
                        <div class="card-body">
                            <div class="chart-container-lg">
                                <canvas id="sofra-sales-chart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="main-card mb-3 card">
                        <div class="card-header">
                            <i class="header-icon pe-7s-cart icon-gradient bg-happy-fisher"> </i>
                            Recent Orders
                        </div>
                        <div class="table-responsive">
                            <table class="align-middle mb-0 table table-borderless table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Order ID</th>
                                        <th>Customer</th>
                                        <th>Items</th>
                                        <th>Total</th>
                                        <th>Status</th>
                                        <th>Date</th>
                                        <th class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>#1042</td>
                                        <td>Ahmed Samir</td>
                                        <td>2x Grilled Chicken, 1x Koshari</td>
                                        <td>420 EGP</td>
                                        <td><div class="badge bg-warning text-dark">Pending</div></td>
                                        <td>08 Aug 2026</td>
                                        <td class="text-center">
                                            <a href="orders.html" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-eye"></i></a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>#1041</td>
                                        <td>Mona Fathy</td>
                                        <td>1x Seafood Pasta</td>
                                        <td>210 EGP</td>
                                        <td><div class="badge bg-info">Preparing</div></td>
                                        <td>08 Aug 2026</td>
                                        <td class="text-center">
                                            <a href="orders.html" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-eye"></i></a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>#1040</td>
                                        <td>Youssef Adel</td>
                                        <td>3x Beef Shawarma</td>
                                        <td>360 EGP</td>
                                        <td><div class="badge bg-primary">Out for Delivery</div></td>
                                        <td>07 Aug 2026</td>
                                        <td class="text-center">
                                            <a href="orders.html" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-eye"></i></a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>#1039</td>
                                        <td>Salma Nabil</td>
                                        <td>1x Mixed Grill</td>
                                        <td>520 EGP</td>
                                        <td><div class="badge bg-success">Completed</div></td>
                                        <td>07 Aug 2026</td>
                                        <td class="text-center">
                                            <a href="orders.html" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-eye"></i></a>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>#1038</td>
                                        <td>Karim Hossam</td>
                                        <td>2x Falafel Sandwich</td>
                                        <td>90 EGP</td>
                                        <td><div class="badge bg-danger">Cancelled</div></td>
                                        <td>06 Aug 2026</td>
                                        <td class="text-center">
                                            <a href="orders.html" class="btn btn-sm btn-outline-primary"><i class="fa-solid fa-eye"></i></a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="d-block text-center card-footer">
                            <a href="orders.html">View All Orders</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
{{/base}}
